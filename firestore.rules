rules_version = '2';

// Paste into Firebase console -> Firestore -> Rules, then Publish.
// Replace the placeholders with the UIDs from Firebase console -> Authentication -> Users.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.uid in ['REPLACE_WITH_UID_1', 'REPLACE_WITH_UID_2'];
    }

    match /households/shared-house/{document=**} {
      allow read, write: if isMember();
    }
  }
}
